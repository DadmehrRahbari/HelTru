---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const architecture = [
  {
    n: '01',
    title: 'The monitored device',
    body: "Any Android phone from 2018 onward. Accelerometer and gyroscope stream at 50Hz through a foreground service that keeps working with the screen off, after the app is killed, and after a reboot.",
    specs: ['HTTP POST every 1 second, key-authenticated', 'FL weights computed locally on-device', 'Survives app kill and reboot'],
  },
  {
    n: '02',
    title: 'The HelTru server',
    body: "Receives a telemetry post, checks the key, computes a risk score against a personal baseline, and broadcasts the result, never touching a raw reading it wasn't already given the right to see.",
    specs: ['Weighted FedAvg + secure aggregation', 'EWMA baseline + fatigue signal', '10-year AI Act audit log'],
  },
  {
    n: '03',
    title: 'Operator dashboard & family portal',
    body: "The screen a caregiver or safety officer actually watches, re-skinned per domain, plus a PIN-only status page for family; no app install, no account, just a link.",
    specs: ['Live per-person risk charts', 'Role-based accounts: admin / caregiver / viewer', 'Installs as a PWA on any device'],
  },
];
---

<BaseLayout title="Platform" description="How HelTru works: federated learning, on-device detection, and the three-part architecture behind six safety-critical domains.">

  <section class="border-b border-mist-300">
    <div class="mx-auto max-w-6xl px-6 pt-16 pb-16 sm:pt-20 sm:pb-20">
      <p class="eyebrow">The platform</p>
      <h1 class="mt-4 max-w-2xl text-4xl sm:text-5xl leading-tight">
        Privacy isn't a policy here. It's a consequence of how the system is built.
      </h1>
      <p class="mt-6 max-w-2xl text-ink-500 text-lg leading-relaxed">
        HelTru is a federated-learning platform: every device trains its own local model on its own motion
        data, and only ever sends home a small, anonymous set of statistical weights. No raw sensor reading,
        location, or health record is ever transmitted or stored centrally.
      </p>
    </div>
  </section>

  <!-- FL comparison -->
  <section class="border-b border-mist-300">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="grid md:grid-cols-2 gap-px bg-mist-300 border border-mist-300">
        <div class="bg-mist-50 p-8">
          <h3 class="font-display text-lg text-ink-500">The way this is usually built</h3>
          <div class="mt-5 font-mono text-sm text-ink-500 leading-loose">
            <span class="border border-mist-300 px-2.5 py-1 inline-block">phone</span>
            <span class="text-ink-500/50 mx-1.5">→</span>
            <span class="border border-mist-300 px-2.5 py-1 inline-block">raw sensor data</span>
            <span class="text-ink-500/50 mx-1.5">→</span>
            <span class="border border-mist-300 px-2.5 py-1 inline-block">cloud server</span>
            <span class="text-ink-500/50 mx-1.5">→</span>
            <span class="border border-mist-300 px-2.5 py-1 inline-block">AI model</span>
          </div>
          <ul class="mt-6 space-y-3 text-ink-500 text-[0.95rem]">
            <li>• Raw accelerometer, GPS, and health-adjacent data leave the device on every reading</li>
            <li>• Privacy is a clause in a data-processing agreement, not a property of the system</li>
            <li>• A server breach exposes real health and location records</li>
            <li>• Data usually lands outside the EU, inheriting cross-border transfer risk</li>
          </ul>
        </div>
        <div class="bg-white p-8">
          <h3 class="font-display text-lg text-evergreen-600">How HelTru is built</h3>
          <div class="mt-5 font-mono text-sm text-evergreen-600 leading-loose">
            <span class="border border-evergreen-500/40 px-2.5 py-1 inline-block">phone</span>
            <span class="text-ink-500/50 mx-1.5">→</span>
            <span class="border border-evergreen-500/40 px-2.5 py-1 inline-block">local weights only</span>
            <span class="text-ink-500/50 mx-1.5">→</span>
            <span class="border border-evergreen-500/40 px-2.5 py-1 inline-block">EU server</span>
            <span class="text-ink-500/50 mx-1.5">→</span>
            <span class="border border-evergreen-500/40 px-2.5 py-1 inline-block">improved model</span>
          </div>
          <ul class="mt-6 space-y-3 text-ink-700 text-[0.95rem]">
            <li>• Each phone trains on its own motion data locally, in place</li>
            <li>• Only nine anonymous statistical values leave the device, every 64 samples</li>
            <li>• A compromised server yields model weights and hashed credentials, never a sensor reading</li>
            <li>• Self-hosted on-premises or in an EU data center, no transatlantic transfer to reason about</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Architecture -->
  <section class="border-b border-mist-300 ripple-field">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="max-w-2xl mb-12">
        <p class="eyebrow">How it works</p>
        <h2 class="mt-4 text-2xl sm:text-3xl">Three components. Nothing sensitive ever leaves the first one.</h2>
        <p class="mt-5 text-ink-500 leading-relaxed">
          No pendant, no wearable, no proprietary hardware to distribute and replace. The phone someone already
          carries is the sensor; the rest of the system exists to notice, escalate, and prove what happened.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-px bg-mist-300 border border-mist-300">
        {architecture.map((a) => (
          <div class="bg-mist-50 p-7">
            <span class="font-mono text-xs text-copper-600">{a.n}</span>
            <h3 class="mt-3 font-display text-lg">{a.title}</h3>
            <p class="mt-3 text-ink-500 text-sm leading-relaxed">{a.body}</p>
            <ul class="mt-5 font-mono text-xs text-ink-500 space-y-2">
              {a.specs.map((s) => <li class="border-t border-mist-300 pt-2">{s}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Engineering maturity -->
  <section class="border-b border-mist-300">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="max-w-2xl mb-10">
        <p class="eyebrow">Engineering maturity</p>
        <h2 class="mt-4 text-2xl sm:text-3xl">Built like infrastructure, tested like one.</h2>
      </div>
      <div class="grid sm:grid-cols-4 gap-6 font-mono text-sm">
        <div class="border-t border-mist-300 pt-4"><p class="text-2xl font-display text-ink-900 font-sans">82</p><p class="text-ink-500 mt-1">automated tests, run in CI on every change</p></div>
        <div class="border-t border-mist-300 pt-4"><p class="text-2xl font-display text-ink-900 font-sans">15</p><p class="text-ink-500 mt-1">test files covering auth, anomaly detection, notifications</p></div>
        <div class="border-t border-mist-300 pt-4"><p class="text-2xl font-display text-ink-900 font-sans">23</p><p class="text-ink-500 mt-1">database tables, authenticated by default</p></div>
        <div class="border-t border-mist-300 pt-4"><p class="text-2xl font-display text-ink-900 font-sans">€0</p><p class="text-ink-500 mt-1">hardware cost, runs on the phone already owned</p></div>
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="max-w-xl">
        <h2 class="text-2xl sm:text-3xl">Want the technical deep dive?</h2>
        <p class="mt-4 text-ink-500 leading-relaxed">A full architecture walkthrough under NDA is available for pilot partners and investors.</p>
        <a href={`${base}/contact`} class="btn-primary mt-6 inline-flex">Request a pilot</a>
      </div>
    </div>
  </section>

</BaseLayout>
